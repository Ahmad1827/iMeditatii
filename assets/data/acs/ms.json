      ],
      "hint": ""
     }
    ],
    "checks": [
     {
      "expr": "close(X([1.5 2 2.7 3.5 5]), [1.5 2 2.7 3.5 5] ./ ([1.5 2 2.7 3.5 5] - 0.5), 1e-9)",
      "msg": "e transformata Z a lui (1/2)ⁿ"
     }
    ],
    "reference": {

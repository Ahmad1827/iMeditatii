   "title": "Laplace pentru t e²ᵗ",
   "chapter": "1. Transformata Laplace",
   "difficulty": "ușoară",
   "source": "",
   "statement": "Calculează transformata Laplace $F(s) = \\mathcal{L}\\{t e^{2t}\\}(s)$, pentru $s > 2$.",
   "hint": "$\\mathcal{L}\\{t\\} = 1/s^2$, iar înmulțirea cu $e^{at}$ deplasează: $s \\to s - a$.",
   "solution": "$F(s) = \\frac{1}{(s-2)^2}$.",
   "kind": "math",
   "spec": {
    "fields": [
     {
      "name": "F",
      "label": "F(s) =",
      "type": "expr",
      "vars": [
       "s"
      ],
      "hint": ""
     }
    ],
    "checks": [
     {
      "expr": "close(F([3 3.5 4.2 5 6.5 8]), 1 ./ ([3 3.5 4.2 5 6.5 8] - 2).^2, 1e-9)",
      "msg": "e transformata lui t e²ᵗ"
     }
    ],
    "reference": {
